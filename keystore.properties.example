# 릴리스 서명 설정 예시. 이 파일을 keystore.properties로 복사하고 값을 채우세요.
# keystore.properties 와 *.jks 는 .gitignore 대상이며 저장소에 올리지 않습니다.
#
# 키 생성 예:
#   keytool -genkeypair -v -keystore signing/modo-release.jks -alias modo-release \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=signing/modo-release.jks
storePassword=CHANGE_ME
keyAlias=modo-release
keyPassword=CHANGE_ME
